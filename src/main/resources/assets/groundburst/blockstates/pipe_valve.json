{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "open": "false",
        "held": "false"
      },
      "apply": {
        "model": "groundburst:block/pipe_valve"
      }
    },
    {
      "when": {
        "OR": [
          {
            "facing": "north",
            "open": "true"
          },
          {
            "facing": "north",
            "held": "true"
          }
        ]
      },
      "apply": {
        "model": "groundburst:block/pipe_valve_open"
      }
    },
    {
      "when": {
        "facing": "north",
        "left": "false"
      },
      "apply": {
        "model": "groundburst:block/wall_pipes_cap_left"
      }
    },
    {
      "when": {
        "facing": "north",
        "right": "false"
      },
      "apply": {
        "model": "groundburst:block/wall_pipes_cap_right"
      }
