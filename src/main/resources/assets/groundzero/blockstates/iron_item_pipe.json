{
  "multipart": [
    {
      "apply": {
        "model": "groundzero:block/iron_item_pipe_core"
      }
    },
    {
      "when": {
        "up": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm"
      }
    },
    {
      "when": {
        "up": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull"
      }
    },
    {
      "when": {
        "down": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm",
        "x": 180
      }
    },
    {
      "when": {
        "down": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull",
        "x": 180
      }
    },
    {
      "when": {
        "north": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm",
        "x": 90
      }
    },
    {
      "when": {
        "north": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull",
        "x": 90
      }
    },
    {
      "when": {
        "east": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "east": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "south": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "south": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "west": "normal|pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_arm",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "west": "pull"
      },
      "apply": {
        "model": "groundzero:block/iron_item_pipe_pull",
        "x": 90,
        "y": 270
      }
    }
  ]
}
